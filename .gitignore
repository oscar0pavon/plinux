src/e2fsprogs-*/
src/gzip-*/
src/tar-*/
src/procps-ng-*/
src/diffutils-*/
src/dosfstools-*/
src/vim-*/
src/less-*/
src/tzdata*/
src/bash-*/
src/libffi-*/
src/wayland-*/
src/seatd-*/
src/libdrm-*/
src/pixman-*/
src/hwdata-*/
src/libdisplay-info-*/
src/xkeyboard-config-*/
src/libxkbcommon-*/
src/libevdev-*/
src/mtdev-*/
src/libinput-*/
src/mesa-*/
src/elfutils-*/
src/libglvnd-*/
src/libpng-*/
src/freetype-*/
