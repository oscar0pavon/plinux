*.o
obj
build/

# $LFS: the chapter 5 cross toolchain and the system being grown alongside
# obj/. Built by ./build.sh toolchain, and not deleted by "clean all".
lfs/

# unpacked by the scripts in toolchain/. gcc's tree holds gmp, mpfr and mpc
# inside it, which is where GCC's build system expects to find them, and
# linux-6.16.1 is there for its headers only -- src/linux stays the kernel
# that gets built and booted.
src/binutils-*/
src/gcc-*/
src/linux-*/

# chapter 6 unpacks here rather than into src/, because eleven of its packages
# are also packages/ packages built from the same tarball with a different
# compiler. toolchain/common.sh explains why sharing the tree is not an option.
src/cross/

src/pgetty/pgetty
src/pinit/pinit

src/shadow/*

# Disk images. The glob rather than disk.raw alone: ./configure.sh takes an
# IMAGE name, and the chroot build needs its own -- disk-lfs.raw is 2.2G and
# one "git add ." away from a history nobody can clone.
virtual_machine/*.raw
virtual_machine/disk
src/plogin/plogin

# cloned by ./configure
src/pboot/
src/linux/

# fetched by ./download.sh from wget-list-sysv, unpacked into src/ by the
# scripts in packages/
sources/
src/coreutils-*/
src/glibc-*/
src/kmod-*/
src/util-linux-*/
src/attr-*/
src/acl-*/
src/libcap-*/
src/openssl-*/
