#!/bin/sh

# Only if one is not already running. init_os calls this, and init_os runs
# again every time the login shell on tty1 comes back -- which is what
# happens when sway exits, since .bash_profile starts it and pinit respawns
# the getty afterwards. udevd does not refuse a second copy: it starts, and
# both instances then process the same uevents.
if ! pgrep -x udevd > /dev/null 2>&1; then
	# This used to go to /dev/null, which meant a udevd that failed left no
	# trace anywhere: nothing on this system calls syslog(3), there is no
	# syslog daemon listening, and the kernel ring buffer only carries the
	# kernel's own messages. One generation is kept, because the boot whose
	# log matters most is usually the one that made you reboot.
	[ -f /var/log/udevd.log ] && mv -f /var/log/udevd.log /var/log/udevd.log.1
	/sbin/udevd --daemon > /var/log/udevd.log 2>&1
fi

# Now traverse /sys in order to "coldplug" devices that have
# already been discovered. Safe to repeat: re-running these only replays
# events for devices that are already there.
/bin/udevadm trigger --action=add    --type=subsystems
/bin/udevadm trigger --action=add    --type=devices
/bin/udevadm trigger --action=change --type=devices



#seatd &





