#!/bin/sh
	
# .bash_profile already sets and creates this when init_os is started from a
# tty1 login. Repeated here so running init_os by hand works too; both are
# idempotent and agree on the value.
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/00-runtime-dir}

if command -v mkdir > /dev/null; then
	mkdir -p -m 0700 "${XDG_RUNTIME_DIR}"
fi

pdevices

# seatd is what sway's session handling talks to; shell_config.sh sets
# LIBSEAT_BACKEND=seatd to match. An image built without it should say so
# once rather than print "command not found" on every boot.
#
# Only if one is not already running, which is the same guard udevd and
# dbus-daemon have and seatd was missing. This script runs again every time
# the login shell on tty1 comes back -- which is what happens when sway exits
# -- and seatd does not refuse a second copy: it logs "Removing leftover
# socket at /run/seatd.sock" and takes /run/seatd.sock over from the first,
# which is left running with nothing connected to it.
#
# Its output went to tty1 alongside sway's, where it was equally unreadable.
# Same file-and-one-generation treatment as udevd, iwd and sway.
#
# The rotation happens only on the path that actually starts seatd. Moving
# the file while a running seatd holds it open would not start a new log --
# the open descriptor follows the inode, so the live daemon would go on
# writing into seatd.log.1.
if command -v seatd > /dev/null; then
	if pgrep -x seatd > /dev/null 2>&1; then
		echo "init_os: seatd already running" >&2
	else
		[ -f /var/log/seatd.log ] && mv -f /var/log/seatd.log /var/log/seatd.log.1
		seatd > /var/log/seatd.log 2>&1 &
	fi
fi

mkdir -p /run/dbus

# The bus refuses to start without a machine ID. --ensure only writes one if
# it is missing, so this costs nothing after the first boot; a fresh image has
# no ID, since baking one in at build time would give every copy the same one.
dbus-uuidgen --ensure=/etc/machine-id

# Only if one is not already running. This script runs at boot from
# .bash_profile on tty1, so running it again by hand -- which is how it gets
# tested -- used to hit the pid file the first run left behind and fail with
# "The pid file /run/dbus/pid exists". /run is a tmpfs, so a pid file with no
# process behind it can only be stale.
if pgrep -x dbus-daemon > /dev/null 2>&1; then
	echo "init_os: system bus already running" >&2
else
	rm -f /run/dbus/pid
	dbus-daemon --system
fi

# iwd's output went to /dev/null, so a radio that never associated -- the
# most likely thing on this machine to fail quietly -- left nothing to read.
# Same one-generation rotation as udevd.
[ -f /var/log/iwd.log ] && mv -f /var/log/iwd.log /var/log/iwd.log.1
set_ip > /var/log/iwd.log 2>&1 &

# The filesystems belong to pinit, which runs "mount -a -F" over /etc/fstab.
# This used to run "mount -a" and "swapon -a" again, kept for machines still
# booting the older pinit, on the reasoning that mount skips anything already
# mounted so it cost nothing. It cost something.
#
# pinit does that work in a forked child and returns immediately, so the disks
# mount while the rest of the boot carries on. On a machine this fast the tty1
# login wins that race: mount here read a mount table the background child had
# not finished writing, saw the filesystems as absent, and mounted every one of
# them a second time, stacked on the first. /boot, /data, /data2, /data3 and
# /data4 were each mounted twice.
#
# It is the same superblock underneath, so nothing was corrupted -- but df and
# findmnt lie, and every unmount at shutdown has to happen twice.

#server &

# sway's output went to tty1, which is the one place it cannot be read: sway
# takes over that display a fraction of a second later, and if it fails
# instead, the errors scroll past behind the login prompt. That is why "sway
# does not start" looked like sway saying nothing at all -- it had been
# printing "Failed to create renderer" the whole time.
#
# So the same treatment udevd and iwd already get: one file, one generation
# kept, because the boot whose log matters is usually the one that made you
# reboot. /var/log is on the root filesystem, not the tmpfs, so it survives.
#
# Not silent, though. The exit status still gets a line on the console, since
# a compositor that quits and leaves you at a shell prompt should say why
# rather than leave you to find the file.
#
# The image is a console system until the sway chain is built. Falling
# through to the login shell is the useful outcome there; dbus-run-session
# exiting with "failed to exec 'sway'" is not.
#SHELL=/usr/bin/zsh dbus-run-session sway
# The guard is on "one is running right now", not on "one has ever run", so
# it does not stop sway being started again after it exits -- that is the
# normal way back into the compositor from the tty1 shell. What it stops is
# the second copy that a hand-run init_os used to start while the first was
# up, which cannot work: the seat is VT-bound and already has an active
# client, so the new sway dies with "Device or resource busy" and takes the
# useful contents of sway.log with it on the way past.
if ! command -v sway > /dev/null; then
	echo "init_os: no sway installed, staying on the console" >&2
elif pgrep -x sway > /dev/null 2>&1; then
	echo "init_os: sway already running" >&2
else
	[ -f /var/log/sway.log ] && mv -f /var/log/sway.log /var/log/sway.log.1

	dbus-run-session sway > /var/log/sway.log 2>&1
	sway_status=$?

	if [ "${sway_status}" -ne 0 ]; then
		echo "init_os: sway exited ${sway_status}, see /var/log/sway.log" >&2
	fi
fi
