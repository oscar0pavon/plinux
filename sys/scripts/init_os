#!/bin/sh
	
# .bash_profile already sets and creates this when init_os is started from a
# tty1 login. Repeated here so running init_os by hand works too; both are
# idempotent and agree on the value.
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/00-runtime-dir}

if command -v mkdir > /dev/null; then
	mkdir -p -m 0700 "${XDG_RUNTIME_DIR}"
fi

pdevices
seatd &

mkdir -p /run/dbus

dbus-daemon --system

set_ip 1&> /dev/null &

swapon /dev/nvme1n1p7
mount /dev/nvme1n1p1 /data
mount /dev/nvme1n1p8 /data3
mount /dev/nvme1n1p9 /data2
mount /dev/nvme1n1p10 /data4

#server &

#SHELL=/usr/bin/zsh dbus-run-session sway
dbus-run-session sway
