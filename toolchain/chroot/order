# LFS chapter 7, run inside the chroot by ./build.sh chroot build.
#
# Everything here installs into /usr with a plain "make install", because /
# is lfs/ now. No DESTDIR, no sysroot, no --host: the isolation is the chroot
# itself rather than a set of flags asking a native compiler to pretend.

# LFS 7.5 and 7.6: the rest of the directory tree, /etc/passwd and /etc/group,
# /etc/hosts, /etc/mtab and the log files. First, because the packages below
# want a /usr/share/man to install into and because bash stops saying
# "I have no name!" once passwd exists.
layout

# 7.7. Only msgfmt, msgmerge and xgettext are wanted; the libraries come in
# chapter 8. Several chapter 8 configure scripts check for msgfmt and quietly
# disable things when it is missing -- glibc's did exactly that in chapter 5.
gettext

# 7.8. The parser generator. Several chapter 8 packages ship pre-generated
# parsers but regenerate them when bison is present.
bison

# 7.9. perl. Half of the chapter 8 packages run a perl script somewhere in
# their build, and autoconf itself is generated by one.
perl

# 7.10. python, needed by chapter 8's meson among other things.
python

# 7.11. makeinfo, without which every GNU package that builds documentation
# stops.
texinfo

# 7.12. util-linux, and this is the one that is here for a specific reason
# rather than a general one: chapter 8 builds it again, *after* udev, so that
# lsblk and findmnt can link libudev. This temporary copy is what breaks that
# cycle -- see packages/util-linux.sh, which currently carries --without-udev
# because the native build has no such escape.
util-linux
