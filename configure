#!/bin/bash
#
# Fetch the component repositories that are developed outside this tree.
# Safe to re-run: anything already cloned is left alone.

cd "$(dirname "$(readlink -f "$0")")" || exit 1

# url and destination, one pair per line
repos=(
  "https://github.com/oscar0pavon/pboot src/pboot"
  "https://github.com/torvalds/linux src/linux"
)

# every clone and every update stays shallow; the kernel's full history is
# several gigabytes and none of it is needed to build
depth=1

# The kernel is an external clone, so its configuration cannot live inside the
# tree: a re-clone or a shallow pull would take it with them. It is kept here
# and copied in instead.
kernel_config=sys/kernel_config
kernel_tree=src/linux

usage(){
  cat <<'USAGE'
Usage: ./configure [command]

Clones the component repositories listed in this script into src/.

Commands:
  (none)      Clone anything missing; existing clones are left untouched
  update      Pull into the clones that are already present
  help        This message

Clones and pulls are shallow. Afterwards sys/kernel_config is copied to
src/linux/.config, unless a .config is already there.

Exit status is 0 only when every step succeeded.
USAGE
}

# Is dir a git working tree in its own right? A plain "-d dir/.git" test would
# miss worktrees and submodules, where .git is a file rather than a directory.
is_clone(){
  git -C "$1" rev-parse --git-dir > /dev/null 2>&1
}

clone_repo(){
  local url=$1 dir=$2

  if [ -e "${dir}" ]; then
    if is_clone "${dir}"; then
      echo "have   ${dir} ($(git -C "${dir}" rev-parse --short HEAD 2>/dev/null))"
      return 0
    fi

    # A non-empty directory that is not a clone is somebody's work, not
    # something to overwrite. git clone would refuse anyway; say why.
    if [ -n "$(ls -A "${dir}" 2>/dev/null)" ]; then
      echo "  ${dir} exists and is not a git clone, leaving it alone" >&2
      return 1
    fi

    rmdir "${dir}" 2>/dev/null
  fi

  echo "clone  ${dir}"
  if ! git clone --depth="${depth}" "${url}" "${dir}"; then
    echo "  failed to clone ${url}" >&2
    return 1
  fi

  return 0
}

install_kernel_config(){
  if [ ! -d "${kernel_tree}" ]; then
    return 0
  fi

  if [ ! -f "${kernel_config}" ]; then
    echo "  ${kernel_config} is missing" >&2
    return 1
  fi

  # An existing .config is the user's current state, possibly edited with
  # menuconfig. Replacing it would silently discard that work.
  if [ -f "${kernel_tree}/.config" ]; then
    echo "have   ${kernel_tree}/.config"
    return 0
  fi

  echo "config ${kernel_tree}/.config from ${kernel_config}"
  if ! cp "${kernel_config}" "${kernel_tree}/.config"; then
    echo "  failed to install ${kernel_config}" >&2
    return 1
  fi

  return 0
}

update_repo(){
  local dir=$2

  if ! is_clone "${dir}"; then
    echo "skip   ${dir} (not a clone)"
    return 0
  fi

  echo "pull   ${dir}"

  # --depth keeps the clone shallow; without it a pull backfills the history
  # the shallow clone was made to avoid. --ff-only so local work is never
  # discarded: a pull that cannot fast-forward is reported, not forced.
  if ! git -C "${dir}" pull --ff-only --depth="${depth}"; then
    echo "  failed to update ${dir}" >&2
    return 1
  fi

  return 0
}

# captured before the loop below, which reuses the positional parameters to
# split each repos entry
command=${1:-}

case "${command}" in
  help|-h|--help)
    usage
    exit 0
    ;;
  ''|update)
    ;;
  *)
    echo "unknown command: ${command}" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac

if ! command -v git > /dev/null; then
  echo "git is required" >&2
  exit 1
fi

failed=0

for entry in "${repos[@]}"; do
  # shellcheck disable=SC2086 # the pair is deliberately word-split
  set -- ${entry}

  if [ "${1:-}" == "" ] || [ "${2:-}" == "" ]; then
    echo "malformed repos entry: ${entry}" >&2
    failed=$((failed + 1))
    continue
  fi

  if [ "${command:-}" == "update" ]; then
    update_repo "$1" "$2" || failed=$((failed + 1))
  else
    clone_repo "$1" "$2" || failed=$((failed + 1))
  fi
done

install_kernel_config || failed=$((failed + 1))

if [ "${failed}" -ne 0 ]; then
  echo
  echo "${failed} step(s) did not complete" >&2
  exit 1
fi

echo
echo "all repositories in place"
